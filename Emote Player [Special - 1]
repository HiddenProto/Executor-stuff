local function fat_scanWorkspace()
    for _, obj in Workspace:GetDescendants() do
        if not obj:IsA("BasePart") then continue end
        if player.Character and obj:IsDescendantOf(player.Character) then continue end
        if obj.Anchored then
            if not obj.CustomPhysicalProperties
            or math.abs(obj.CustomPhysicalProperties.Elasticity - 0) > 0.001 then
                obj.CustomPhysicalProperties = ZERO_BOUNCE
            end
        else
            fat_applyLightToPart(obj)
        end
    end
end


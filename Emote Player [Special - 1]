    lbl.TextColor3         = Color3.new(1, 1, 1)
    lbl.Font               = Enum.Font.Gotham
    lbl.TextSize           = 13
    lbl.TextXAlignment     = Enum.TextXAlignment.Left
    lbl.Parent             = container

    local tb = Instance.new("TextBox")
    tb.Size            = UDim2.new(0.35, -12, 0, 22)
    tb.Position        = UDim2.new(0.65, 0, 0, 8)
    tb.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    tb.Text            = tostring(default)
    tb.TextColor3      = Color3.new(1, 1, 1)
    tb.Font            = Enum.Font.Gotham
    tb.TextSize        = 13
    tb.ClearTextOnFocus = false
    tb.Parent          = container
    Instance.new("UICorner", tb).CornerRadius = UDim.new(0, 6)

    local track = Instance.new("Frame")
    track.Size            = UDim2.new(1, -24, 0, 10)
    track.Position        = UDim2.new(0, 12, 0, 44)
    track.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    track.Active          = true
    track.Parent          = container
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
    fill.Size             = UDim2.new(0, 0, 1, 0)
    fill.Parent           = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local thumb = Instance.new("Frame")
    thumb.Size        = UDim2.new(0, 18, 0, 18)
    thumb.AnchorPoint = Vector2.new(0.5, 0.5)
    thumb.Position    = UDim2.new(0, 0, 0.5, 0)
    thumb.BackgroundColor3 = Color3.fromRGB(220, 220, 220)
    thumb.Active      = true
    thumb.Parent      = track
    Instance.new("UICorner", thumb).CornerRadius = UDim.new(1, 0)

    local currentVal = default
    local dragging   = false

    local function apply(v)
        currentVal = math.clamp(math.floor(v * 100) / 100, minVal, maxVal)
        lbl.Text   = string.format("%s: %.2f", name, currentVal)
        tb.Text    = string.format("%.2f", currentVal)
        local rel  = (currentVal - minVal) / (maxVal - minVal)
        fill.Size  = UDim2.new(rel, 0, 1, 0)
        thumb.Position = UDim2.new(rel, 0, 0.5, 0)
        if onChange then onChange(currentVal) end
    end

    local function fromMouse(inp)
        local rel = math.clamp(
            (inp.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        apply(minVal + (maxVal - minVal) * rel)
    end

    track.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; fromMouse(inp)
        end
    end)
    thumb.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
            fromMouse(inp)
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    tb.FocusLost:Connect(function(enter)
        if enter then
            local n = tonumber(tb.Text)
            if n then apply(n) else tb.Text = string.format("%.2f", currentVal) end
        end
    end)

    apply(default)
    return apply
end

local emotePage     = tabPages["Emotes"]
local currentEmote  = nil
local activeEmoteBtn = nil

local function stopEmote()
    if currentEmote then
        currentEmote:Stop(Settings.FadeOut)
        currentEmote = nil
    end
    if activeEmoteBtn then
        activeEmoteBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        activeEmoteBtn = nil
    end
end

local function playEmote(id, btn)
    stopEmote()
    local animId = resolveAnimId(id)
    local track  = humanoid:LoadAnimation(newAnim(animId))
    track.Priority = Settings.Priority
    track.Looped   = true
    track:Play(Settings.FadeIn, Settings.Weight, 1)
    currentEmote   = track
    activeEmoteBtn = btn
    if btn then btn.BackgroundColor3 = Color3.fromRGB(0, 130, 215) end

    if Settings.WobbleEnabled then
        task.delay(0.08, function()
            if currentEmote ~= track then return end
            local len = track.Length
            if len <= 0 then len = animLengths[id] or 0 end
            if len <= 0 then return end

            track:AdjustSpeed(0)
            local startCenter = 0.15 * len
            local range       = math.clamp(Settings.WobbleRange, 0, 0.5) * len
            local elapsed     = 0
            local phase       = 0
            local wobConn
            wobConn = RunService.Heartbeat:Connect(function(dt)
                if currentEmote ~= track then
                    wobConn:Disconnect()
                    return
                end
                elapsed = elapsed + dt
                if elapsed >= Settings.WobbleDuration then
                    wobConn:Disconnect()
                    track.TimePosition = 0
                    track:AdjustSpeed(1)
                    return
                end
                local progress  = elapsed / Settings.WobbleDuration
                local decay     = (1 - progress)
                local centerPos = startCenter * (1 - progress)
                phase = phase + Settings.WobbleSpeed * decay * dt * math.pi * 2
                local offset = math.sin(phase) * range * decay
                track.TimePosition = math.clamp(centerPos + offset, 0, len)
            end)
        end)
    end
end


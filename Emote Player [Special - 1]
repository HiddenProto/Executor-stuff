local resolveCache = {}
local function resolveAnimId(id)
    local key = tostring(id)
    if resolveCache[key] then return resolveCache[key] end
    local ok, result = pcall(function()
        return game:GetObjects("rbxassetid://" .. key)
    end)
    if ok and result then
        for _, obj in result do
            if obj:IsA("Animation") then
                resolveCache[key] = obj.AnimationId
                return obj.AnimationId
            end
            for _, desc in obj:GetDescendants() do
                if desc:IsA("Animation") then
                    resolveCache[key] = desc.AnimationId
                    return desc.AnimationId
                end
            end
        end
    end
    local fallback = "rbxassetid://" .. key
    resolveCache[key] = fallback
    return fallback
end

local function newAnim(animId)
    local a = Instance.new("Animation")
    a.AnimationId = animId
    return a
end

local function lerp(a, b, t) return a + (b - a) * t end

local limpTrack    = nil
local limpEnabled  = false
local LIMP_ANIM_ID = 92198004084765

local function startLimp()
    if limpTrack and limpTrack.IsPlaying then return end
    local animId = resolveAnimId(LIMP_ANIM_ID)
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then return end
    limpTrack = animator:LoadAnimation(newAnim(animId))
    limpTrack.Priority = Enum.AnimationPriority.Movement
    limpTrack.Looped   = true
    limpTrack:Play(0.3, 0.65, 1)
end

local function stopLimp()
    if limpTrack then
        limpTrack:Stop(0.4)
        limpTrack = nil
    end
end


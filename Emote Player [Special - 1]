local puppetTracks   = {}

local function stopPuppet()
    if puppetConn then puppetConn:Disconnect() puppetConn = nil end
    if puppetTrack then puppetTrack:Stop(0.2) puppetTrack = nil end
    for id, t in pairs(puppetTracks) do
        if t and t.IsPlaying then t:Stop(0.2) end
    end
    puppetTracks  = {}
    puppetTarget  = nil
    puppetCurrentId = nil
end

local function destroyPuppetTool()
    stopPuppet()
    if puppetTool and puppetTool.Parent then puppetTool:Destroy() end
    puppetTool = nil
end

local function getClosestPlayerFromMouse()
    local target = mouse.Target
    if target then
        for _, plr in Players:GetPlayers() do
            if plr ~= player and plr.Character and target:IsDescendantOf(plr.Character) then
                return plr
            end
        end
    end
    local unit = mouse.UnitRay
    local best, bestDist = nil, math.huge
    for _, plr in Players:GetPlayers() do
        if plr == player or not plr.Character then continue end
        local targetHrp = plr.Character:FindFirstChild("HumanoidRootPart")
        if not targetHrp then continue end
        local toTarget = targetHrp.Position - unit.Origin
        local along    = toTarget:Dot(unit.Direction)
        if along < 0 then continue end
        local closest  = unit.Origin + unit.Direction * along
        local dist     = (targetHrp.Position - closest).Magnitude
        if dist < bestDist and dist < 25 then
            bestDist = dist
            best = plr
        end
    end
    return best
end

local function puppetTick()
    if not puppetTarget then return end

    local char = puppetTarget.Character
    if not char or not char.Parent then
        stopPuppet()
        return
    end

    local tHum = char:FindFirstChildOfClass("Humanoid")
    local tAnimator = char:FindFirstChildOfClass("Animator")
        or (tHum and tHum:FindFirstChildOfClass("Animator"))
    if not tHum then stopPuppet() return end

    local myAnimator = humanoid:FindFirstChildOfClass("Animator")
    if not myAnimator then return end

    local playing = tHum:GetPlayingAnimationTracks()
    local targetIds = {}
    for _, t in playing do
        local ok, id = pcall(function() return t.Animation.AnimationId end)
        if ok and id and id ~= "" then
            targetIds[id] = t
        end
    end

    for id, myTrack in pairs(puppetTracks) do
        if not targetIds[id] then
            if myTrack.IsPlaying then myTrack:Stop(0.1) end
            puppetTracks[id] = nil
        end
    end

    for id, srcTrack in pairs(targetIds) do
        if not puppetTracks[id] or not puppetTracks[id].IsPlaying then
            local a = Instance.new("Animation")
            a.AnimationId = id
            local ok2, myTrack = pcall(function() return myAnimator:LoadAnimation(a) end)
            if not ok2 or not myTrack then continue end
            myTrack.Priority = Enum.AnimationPriority.Action4
            myTrack.Looped   = srcTrack.Looped
            myTrack:Play(0, srcTrack.WeightCurrent, srcTrack.Speed)
            task.defer(function()
                if myTrack and myTrack.IsPlaying then
                    myTrack.TimePosition = srcTrack.TimePosition
                end
            end)
            puppetTracks[id] = myTrack
        else
            local myTrack = puppetTracks[id]
            if math.abs(myTrack.TimePosition - srcTrack.TimePosition) > 0.12 then
                myTrack.TimePosition = srcTrack.TimePosition
            end
            if math.abs(myTrack.Speed - srcTrack.Speed) > 0.01 then
                myTrack:AdjustSpeed(srcTrack.Speed)
            end
        end
    end
end

local function mirrorPlayer(targetPlr)
    stopPuppet()
    puppetTarget   = targetPlr
    puppetCurrentId = nil

    puppetTick()

    local elapsed = 0
    puppetConn = RunService.Heartbeat:Connect(function(dt)
        elapsed = elapsed + dt
        if elapsed >= 0.05 then
            elapsed = 0
            puppetTick()
        end
    end)
end


local bhopTool  = nil
local bhopTrack = nil
local bhopConns = {}
local bhopActive = false

local BHOP_MAX_SPEED  = 50
local BHOP_GROUND_CAP = 20
local BHOP_ACCEL      = 10
local BHOP_DECEL      = 18
local BHOP_JUMP_ADD   = 9

local function clearBhopConns()
    for _, c in ipairs(bhopConns) do pcall(function() c:Disconnect() end) end
    bhopConns = {}
end

local function destroyBhopTool()
    if bhopTool and bhopTool.Parent then bhopTool:Destroy() end
    bhopTool = nil
end

local function createBhopTool()
    destroyBhopTool()
    clearBhopConns()

    local tool = Instance.new("Tool")
    tool.Name           = "BHop"
    tool.RequiresHandle = false
    tool.CanBeDropped   = false
    tool.Parent         = player.Backpack
    bhopTool            = tool

    local savedJump  = nil
    local savedSpeed = nil
    local bhopSpeed  = 0
    local jumpPart   = nil

    local function removeJumpPart()
        if jumpPart and jumpPart.Parent then
            jumpPart:Destroy()
        end
        jumpPart = nil
    end

    local function spawnJumpPart()
        removeJumpPart()
        local p = Instance.new("Part")
        p.Name        = "_BhopJumpPad"
        p.Size        = Vector3.new(6, 0.4, 6)
        p.Anchored    = true
        p.CanCollide  = true
        p.Transparency = 0.85
        p.Material    = Enum.Material.SmoothPlastic
        p.BrickColor  = BrickColor.new("Bright blue")
        local feetY = hrp.Position.Y - (humanoid.HipHeight + hrp.Size.Y / 2)
        p.CFrame = CFrame.new(hrp.Position.X, feetY - 0.2, hrp.Position.Z)
        p.Parent  = workspace
        jumpPart  = p

        task.delay(0.5, removeJumpPart)
    end

    tool.Equipped:Connect(function()
        bhopActive = true
        bhopSpeed  = 0

        savedJump  = humanoid.JumpPower
        savedSpeed = humanoid.WalkSpeed

        humanoid.JumpPower = savedJump + BHOP_JUMP_ADD

        local animId = resolveAnimId(TOOL_IDS.bhop)
        local track  = humanoid:LoadAnimation(newAnim(animId))
        track.Priority = Settings.Priority
        track.Looped   = true
        track:Play(0.1, 1, 1)
        bhopTrack = track

        local moveConn = RunService.Heartbeat:Connect(function(dt)
            if not bhopActive then return end
            local md         = humanoid.MoveDirection
            local isMoving   = md.Magnitude > 0.1
            local isGrounded = humanoid.FloorMaterial ~= Enum.Material.Air

            local onOwnPad = false
            if isGrounded and jumpPart and jumpPart.Parent then
                local touching = hrp:GetTouchingParts()
                for _, p in touching do
                    if p == jumpPart then onOwnPad = true break end
                end
            end

            if onOwnPad then
            elseif isGrounded then
                if isMoving then
                    if bhopSpeed < BHOP_GROUND_CAP then
                        bhopSpeed = math.min(bhopSpeed + BHOP_ACCEL * dt, BHOP_GROUND_CAP)
                    else
                        bhopSpeed = math.max(bhopSpeed - BHOP_DECEL * dt, BHOP_GROUND_CAP)
                    end
                else
                    bhopSpeed = math.max(bhopSpeed - BHOP_DECEL * dt, 0)
                end
            else
                if isMoving then
                    bhopSpeed = math.min(bhopSpeed + BHOP_ACCEL * dt, BHOP_MAX_SPEED)
                end
            end

            humanoid.WalkSpeed = bhopSpeed
            if bhopTrack and bhopTrack.IsPlaying then
                bhopTrack:AdjustSpeed(1)
            end
        end)
        table.insert(bhopConns, moveConn)

        local jumpConn = UserInputService.JumpRequest:Connect(function()
            if not bhopActive then return end
            local state = humanoid:GetState()
            if state == Enum.HumanoidStateType.Freefall
            or state == Enum.HumanoidStateType.Jumping then
                spawnJumpPart()
                task.delay(0.06, function()
                    if bhopActive then
                        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                    end
                    removeJumpPart()
                end)
            end
        end)
        table.insert(bhopConns, jumpConn)

        local landConn = humanoid.StateChanged:Connect(function(old, new)
            if not bhopActive then return end
            if (old == Enum.HumanoidStateType.Freefall or old == Enum.HumanoidStateType.Jumping)
            and new == Enum.HumanoidStateType.Landed then
                local fallSpeed = math.abs(hrp.Velocity.Y)
                local cushionStrength = math.clamp(fallSpeed * 0.55, 4, 48)
                local cushionDuration = math.clamp(fallSpeed * 0.012, 0.18, 0.55)

                humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)

                local bv = Instance.new("BodyVelocity")
                bv.Velocity        = Vector3.new(0, cushionStrength, 0)
                bv.MaxForce        = Vector3.new(0, math.huge, 0)
                bv.P               = 5e4
                bv.Parent          = hrp

                local elapsed = 0
                local fadeConn
                fadeConn = RunService.Heartbeat:Connect(function(dt)
                    elapsed = elapsed + dt
                    local t = math.clamp(elapsed / cushionDuration, 0, 1)
                    bv.Velocity = Vector3.new(0, cushionStrength * (1 - t), 0)
                    if t >= 1 then
                        fadeConn:Disconnect()
                        bv:Destroy()
                    end
                end)
            end
        end)
        table.insert(bhopConns, landConn)

        local lastVY = 0
        local SUDDEN_THRESHOLD = -8
        local preSimConn = RunService.PreSimulation:Connect(function(dt)
            if not bhopActive then return end
            local vel   = hrp.AssemblyLinearVelocity
            local vy    = vel.Y
            local delta = vy - lastVY
            if math.abs(delta) > 8 then
                local smoothed = lastVY + delta * 0.5
                hrp.AssemblyLinearVelocity = Vector3.new(vel.X, smoothed, vel.Z)
                lastVY = smoothed
            else
                lastVY = vy
            end
        end)
        table.insert(bhopConns, preSimConn)

        local bhopRespawnConn = player.CharacterAdded:Connect(function(c)
            bhopActive = false
            clearBhopConns()
            removeJumpPart()
            if bhopTrack then bhopTrack:Stop(0) bhopTrack = nil end
            if savedJump  then humanoid.JumpPower = savedJump  savedJump  = nil end
            if savedSpeed then humanoid.WalkSpeed = savedSpeed savedSpeed = nil end
            bhopSpeed = 0
        end)
        table.insert(bhopConns, bhopRespawnConn)

    end)

    tool.Unequipped:Connect(function()
        bhopActive = false
        clearBhopConns()
        removeJumpPart()

        if bhopTrack then
            bhopTrack:Stop(0.15)
            bhopTrack = nil
        end

        if savedJump  then humanoid.JumpPower = savedJump  end
        if savedSpeed then humanoid.WalkSpeed = savedSpeed end
        savedJump  = nil
        savedSpeed = nil
        bhopSpeed  = 0
    end)
end


local function preloadAll()
    local ids = {}
    local idMeta = {} -- parallel table for name + emote ref

    for _, e in ipairs(EMOTES) do
        table.insert(ids, { id = e.id, label = e.name, emote = e })
    end
    table.insert(ids, { id = TOOL_IDS.instantTransmission, label = "Instant Transmission" })
    table.insert(ids, { id = TOOL_IDS.bhop,                label = "BHop" })
    table.insert(ids, { id = LIMP_ANIM_ID,                 label = "Limp" })
    table.insert(ids, { id = 109863797124787,              label = "IT Arrival" })

    local total = #ids

    for i, entry in ipairs(ids) do
        loadStatus.Text = string.format("Loading %d / %d  —  %s", i, total, entry.label)
        TweenService:Create(barFill, TweenInfo.new(0.18), {
            Size = UDim2.new(i / total, 0, 1, 0)
        }):Play()

        local ok, animId = pcall(resolveAnimId, entry.id)
        if ok and animId then
            local ok2, track = pcall(function()
                return humanoid:LoadAnimation(newAnim(animId))
            end)
            if ok2 and track then
                track:Play(0, 1, 100)
                task.wait(0.07)
                local len = track.Length
                animLengths[entry.id] = len
                track:Stop(0)

                if entry.emote and entry.emote._lenLabel then
                    entry.emote._lenLabel.Text = string.format("%.1fs", len)
                end
            end
        end

        task.wait(0.03)
    end

    loadStatus.Text = "✓ All animations cached!"
    task.wait(0.45)

    TweenService:Create(loadFrame, TweenInfo.new(0.3), {
        BackgroundTransparency = 1
    }):Play()
    for _, d in ipairs(loadFrame:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            TweenService:Create(d, TweenInfo.new(0.3), {
                BackgroundTransparency = 1,
                TextTransparency       = 1,
            }):Play()
        elseif d:IsA("Frame") then
            TweenService:Create(d, TweenInfo.new(0.3), {
                BackgroundTransparency = 1,
            }):Play()
        end
    end
    task.wait(0.35)
    loadFrame.Visible  = false
    mainFrame.Visible  = true
end


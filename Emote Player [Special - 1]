local function fat_getPlayersOnPart(part)
    local touching = part:GetTouchingParts() or {}
    local result = {}
    for _, tp in touching do
        for _, plr in Players:GetPlayers() do
            if plr ~= player and plr.Character and tp:IsDescendantOf(plr.Character) then
                table.insert(result, plr)
                break
            end
        end
    end
    return result
end

local function fat_getPlayersInVehicle(part)
    local model = part:FindFirstAncestorOfClass("Model")
    if not model then return {} end
    local result = {}
    for _, desc in model:GetDescendants() do
        if desc:IsA("Seat") or desc:IsA("VehicleSeat") then
            local occupant = desc.Occupant
            if occupant then
                local plr = Players:GetPlayerFromCharacter(occupant.Parent)
                if plr and plr ~= player then
                    table.insert(result, plr)
                end
            end
        end
    end
    return result
end

local function fat_applyProperties(part, props)
    if not part:IsA("BasePart") then return end
    if part.Anchored then
        if not fat_anchorWatched[part] then
            fat_anchorWatched[part] = true
            part:GetPropertyChangedSignal("Anchored"):Connect(function()
                if not part.Anchored and part:IsDescendantOf(game) then
                    fat_applyProperties(part, props)
                end
            end)
            part.AncestryChanged:Connect(function()
                if not part:IsDescendantOf(game) then
                    fat_anchorWatched[part] = nil
                end
            end)
        end
        return
    end

    if not part.CustomPhysicalProperties
    or math.abs(part.CustomPhysicalProperties.Density - props.Density) > 0.001 then
        part.CustomPhysicalProperties = props
    end

    if fat_propertyConnections[part] then return end

    local conn = part:GetPropertyChangedSignal("CustomPhysicalProperties"):Connect(function()
        if part.Anchored then return end
        if not part.CustomPhysicalProperties
        or math.abs(part.CustomPhysicalProperties.Density - props.Density) > 0.001 then
            part.CustomPhysicalProperties = props
        end
    end)
    fat_propertyConnections[part] = conn

    part.AncestryChanged:Connect(function()
        if not part:IsDescendantOf(game) then
            if fat_propertyConnections[part] then
                fat_propertyConnections[part]:Disconnect()
                fat_propertyConnections[part] = nil
            end
            fat_playerPartCache[part]      = nil
            fat_partLastPushed[part]       = nil
            fat_anchorWatched[part]        = nil
        end
    end)
end

local function fat_makeCharacterHeavy(char)
    if not char then return end
    task.wait(0.3)

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.AutoJumpEnabled = false
        hum.BreakJointsOnDeath = false
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,     false)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Physics,     false)
    end

    for _, obj in char:GetDescendants() do
        if obj.Name == "HumanoidRootPart" then
            fat_applyProperties(obj, CHAR_PART_PROPS.HumanoidRootPart)
            fat_playerPartCache[obj] = true
        end
    end

    char.DescendantAdded:Connect(function(obj)
        if obj.Name == "HumanoidRootPart" then
            fat_applyProperties(obj, CHAR_PART_PROPS.HumanoidRootPart)
            fat_playerPartCache[obj] = true
        end
    end)

    local root = char:WaitForChild("HumanoidRootPart", 5)
    if not root then return end

    if fat_pushConnection then
        fat_pushConnection:Disconnect()
        fat_pushConnection = nil
    end

    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {char}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude

    fat_pushConnection = RunService.PreSimulation:Connect(function()
        if not root or not root.Parent then return end

        local currentlyTouching = {}
        for _, cp in char:GetDescendants() do
            if not cp:IsA("BasePart") then continue end
            local touching = cp:GetTouchingParts()
            if typeof(touching) ~= "table" then continue end
            for _, p in touching do
                if not p:IsA("BasePart") then continue end
                if not p.Anchored then continue end
                if p:IsDescendantOf(char) then continue end
                currentlyTouching[p] = true
                if not fat_anchoredPatched[p] then
                    fat_anchoredPatched[p]        = true
                    fat_anchoredOriginalProps[p]   = p.CustomPhysicalProperties
                    p.CustomPhysicalProperties     = ZERO_BOUNCE
                end
            end
        end

        for p in pairs(fat_anchoredPatched) do
            if not currentlyTouching[p] then
                if p and p.Parent then
                    p.CustomPhysicalProperties = fat_anchoredOriginalProps[p]
                end
                fat_anchoredPatched[p]      = nil
                fat_anchoredOriginalProps[p] = nil
            end
        end

        local floorRay = Workspace:Raycast(root.Position, Vector3.new(0, -3.5, 0), rayParams)
        if floorRay and floorRay.Instance and floorRay.Instance.Anchored then return end

        if not hum or hum.MoveDirection.Magnitude < 0.1 then return end

        local pushDir    = hum.MoveDirection
        local directTouch = root:GetTouchingParts()
        if typeof(directTouch) ~= "table" or #directTouch == 0 then return end

        local toPush = {}
        local visited = {}

        local function collectConnected(current)
            if not current or not current:IsA("BasePart") then return end
            if current.Anchored then return end
            if current:IsDescendantOf(char) then return end
            if visited[current] then return end
            visited[current]  = true
            toPush[current]   = true
            local touching = current:GetTouchingParts()
            if typeof(touching) == "table" then
                for _, other in touching do collectConnected(other) end
            end
        end

        for _, part in directTouch do
            if part:IsA("BasePart") and not part.Anchored and not part:IsDescendantOf(char) then
                collectConnected(part)
            end
        end

        if next(toPush) == nil then return end

        local now = tick()
        for part in toPush do
            if not part or not part.Parent then continue end
            if part.Anchored then continue end
            if part:GetRootPart() == root then continue end
            if (root.Position.Y - part.Position.Y) > 1.5 then continue end

            local last = fat_partLastPushed[part]
            if last and (now - last) < PUSH_COOLDOWN then continue end

            local blockedByAnchor = false
            local neighbors = part:GetTouchingParts()
            if typeof(neighbors) == "table" then
                for _, n in neighbors do
                    if n.Anchored then
                        local toN = Vector3.new(
                            n.Position.X - part.Position.X, 0,
                            n.Position.Z - part.Position.Z)
                        if toN.Magnitude > 0.01 and toN.Unit:Dot(pushDir) > 0.5 then
                            blockedByAnchor = true
                            break
                        end
                    end
                end
            end
            if blockedByAnchor then continue end

            fat_partLastPushed[part] = now

            local onPart  = fat_getPlayersOnPart(part)
            local inVeh   = fat_getPlayersInVehicle(part)
            local blocked = #onPart > 0 or #inVeh > 0
            local force   = blocked and (NETLESS_FORCE * EXTRA_MULTIPLIER) or NETLESS_FORCE
            local target  = pushDir * force

            local cv   = part.AssemblyLinearVelocity
            local safeY = math.clamp(cv.Y, -50, 2)
            part.AssemblyLinearVelocity = Vector3.new(
                cv.X + (target.X - cv.X) * 0.4,
                safeY,
                cv.Z + (target.Z - cv.Z) * 0.4
            )

            for _, plr in onPart do
                if plr == player or not plr.Character then continue end
                local pr = plr.Character:FindFirstChild("HumanoidRootPart")
                if pr and pr.Parent then
                    local rv = pr.AssemblyLinearVelocity
                    pr.AssemblyLinearVelocity = Vector3.new(
                        rv.X + (target.X - rv.X) * 0.4,
                        math.clamp(rv.Y, -50, 2),
                        rv.Z + (target.Z - rv.Z) * 0.4
                    )
                end
            end

            for _, plr in inVeh do
                if plr == player or not plr.Character then continue end
                local pr = plr.Character:FindFirstChild("HumanoidRootPart")
                if pr and pr.Parent then
                    local rv = pr.AssemblyLinearVelocity
                    pr.AssemblyLinearVelocity = Vector3.new(
                        rv.X + (target.X - rv.X) * 0.4,
                        math.clamp(rv.Y, -50, 2),
                        rv.Z + (target.Z - rv.Z) * 0.4
                    )
                end
            end
        end
    end)
end

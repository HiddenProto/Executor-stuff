local function createITTool()
    destroyITTool()
    local tool = Instance.new("Tool")
    tool.Name           = "Instant Transmission"
    tool.RequiresHandle = false
    tool.CanBeDropped   = false
    tool.Parent         = player.Backpack
    itTool              = tool

    local lockedTarget = nil

    local function cancelIT()
        itAnimating = false
        lockedTarget = nil
        if itTrack then
            itTrack:Stop(0.15)
            itTrack = nil
        end
    end

    tool.Equipped:Connect(function()
        itAnimating = false
        lockedTarget = nil
    end)

    tool.Unequipped:Connect(function()
        cancelIT()
    end)

    tool.Activated:Connect(function()
        if itAnimating then return end -- locked once playing

        lockedTarget = mouse.Hit.Position
        itAnimating  = true

        local animId = resolveAnimId(TOOL_IDS.instantTransmission)
        local track  = humanoid:LoadAnimation(newAnim(animId))
        track.Priority = Enum.AnimationPriority.Action4
        track.Looped   = false
        track:Play(0.1, 1, 1)
        itTrack = track

        local itLen = animLengths[TOOL_IDS.instantTransmission] or track.Length
        local earlyTime = math.max(itLen - 0.5, 0)
        task.delay(earlyTime, function()
            if itAnimating and lockedTarget then
                hrp.CFrame = CFrame.new(lockedTarget + Vector3.new(0, 3.5, 0))
                track:Stop(0.15)
                cancelIT()

                local arrivalAnimId = resolveAnimId(109863797124787)
                local arrivalTrack = humanoid:LoadAnimation(newAnim(arrivalAnimId))
                arrivalTrack.Priority = Enum.AnimationPriority.Action4
                arrivalTrack.Looped   = false
                arrivalTrack:Play(0.05, 1, -0.5)

                task.delay(0.1, function()
                    local arrivalLen = animLengths[109863797124787]
                    if not arrivalLen or arrivalLen <= 0 then
                        arrivalLen = arrivalTrack.Length
                    end
                    if arrivalTrack and arrivalTrack.IsPlaying then
                        arrivalTrack.TimePosition = math.min(1.0, arrivalLen - 0.05)
                    end
                end)
            end
        end)
        track.Stopped:Connect(function()
            cancelIT()
        end)
    end)
end

